# 本机知识检索索引和缓存
.smart-env/

# Obsidian 当前窗口、标签和布局状态
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# 插件本地数据可能包含密钥、账号会话或位置，不纳入版本控制
.obsidian/plugins/*/data.json

# Dashboard 自动备份，原文件保留在本机
.dashboard-backup/

# 本地环境变量与凭据（允许提交不含真实凭据的示例）
.env
.env.*
!.env.example

# Obsidian 本地回收目录
.trash/

# 操作系统生成的元数据
Thumbs.db
Desktop.ini
.DS_Store
